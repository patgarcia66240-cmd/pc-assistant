# Port de l'API locale exposée par ce pont (appelée par le backend ARIA)
PORT=3001

# URL du backend ARIA (celle que python main.py sert, voir backend/config.py API_HOST/API_PORT)
BACKEND_URL=http://127.0.0.1:8000

# Doit être EXACTEMENT la même valeur que WHATSAPP_BRIDGE_SECRET dans backend/.env.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
WHATSAPP_BRIDGE_SECRET=

# Dossier où Baileys sauvegarde la session WhatsApp après le premier scan du QR code (pas besoin
# de rescanner à chaque redémarrage tant que ce dossier existe). Ne jamais commit ce dossier —
# voir .gitignore.
AUTH_DIR=./auth
