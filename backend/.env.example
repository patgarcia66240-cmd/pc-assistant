# Claude API
CLAUDE_API_KEY=your_api_key_here
AI_PROVIDER=anthropic
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Fournisseurs IA alternatifs (la clé peut aussi être enregistrée depuis les paramètres ARIA).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Twelve Data (actions, ETF, tendances des marchés) - clé gratuite sur https://twelvedata.com/
# (800 requêtes/jour, sans carte bancaire). Le forex ne nécessite pas de clé (Frankfurter/BCE).
TWELVE_DATA_API_KEY=your_api_key_here

# EODHD (CAC 40) - clé gratuite sur https://eodhd.com/ (plan gratuit : 20 requêtes/jour, données
# de fin de journée uniquement, pas de temps réel). La réponse est mise en cache un jour civil
# côté backend pour ménager ce quota.
EODHD_API_KEY=your_api_key_here

# Metal Sentinel (métaux : or/argent/platine/palladium/cuivre/aluminium/plomb/nickel/zinc) - clé
# RapidAPI gratuite sur https://rapidapi.com/ (rechercher "Metal Sentinel", s'abonner au plan
# gratuit). Cours actuels (bid/ask/mid), rafraîchis en continu.
METAL_SENTINEL_API_KEY=your_api_key_here

# Google Agenda (onglet Agenda, lecture/écriture des événements) - identifiants OAuth d'un
# projet Google Cloud (type "Application Web"), Calendar API activée. Voir les instructions de
# configuration fournies séparément pour la procédure pas à pas.
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
# À changer seulement si l'appli tourne sur un autre port que 8000, ET si cette même valeur est
# aussi enregistrée comme URI de redirection autorisée côté Google Cloud Console.
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/api/calendar/oauth/callback

# Protection optionnelle des routes configuration/calendrier sensibles.
# Laisser vide pour le développement local ; définir une valeur aléatoire en réseau.
API_AUTH_TOKEN=

# Pont WhatsApp (voir whatsapp-bridge/ à la racine du repo + backend/plugins/whatsapp/).
# WHATSAPP_BRIDGE_SECRET : valeur aléatoire, identique ici et dans whatsapp-bridge/.env
# (générer avec `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# WHATSAPP_ALLOWED_NUMBERS : numéros autorisés à parler à ARIA, séparés par des virgules,
# format international sans "+" ni espaces (ex: 33612345678). Vide = aucun message traité.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_BRIDGE_SECRET=
WHATSAPP_ALLOWED_NUMBERS=

# Bot Telegram (backend/telegram_bot.py, voir backend/plugins/telegram/) — gratuit, pas de
# service séparé à faire tourner. TELEGRAM_BOT_TOKEN : créé via @BotFather sur Telegram
# (envoyer /newbot, suivre les instructions). TELEGRAM_BRIDGE_SECRET : valeur aléatoire (même
# commande que pour WhatsApp ci-dessus). TELEGRAM_ALLOWED_USER_IDS : identifiants Telegram
# numériques autorisés à parler à ARIA, séparés par des virgules (obtenir le sien en écrivant à
# @userinfobot sur Telegram). Vide = aucun message traité.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BRIDGE_SECRET=
TELEGRAM_ALLOWED_USER_IDS=

# Synthèse vocale locale Kokoro
# Les chemins par défaut pointent vers backend/data/tts/.
# KOKORO_MODEL_PATH=data/tts/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=data/tts/voices-v1.0.bin
KOKORO_VOICE=ff_siwis

# Synthèse vocale locale Piper (plus rapide)
# Modèle français conseillé : fr_FR-siwis-medium
# python -m piper.download_voices --data-dir data/tts fr_FR-siwis-medium
# PIPER_MODEL_PATH=data/tts/fr_FR-siwis-medium.onnx
# PIPER_CONFIG_PATH=data/tts/fr_FR-siwis-medium.onnx.json
PIPER_USE_CUDA=false

# Database
DATABASE_URL=sqlite:///./pc_assistant.db

# ARIA Personality
ARIA_NAME=ARIA
ARIA_AVATAR=🤖
ARIA_LANGUAGE=fr
USER_COUNTRY=France
USER_CITY_LABEL=Saint-Martin-de-Crau
